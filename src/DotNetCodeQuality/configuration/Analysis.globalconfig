is_global = true

# Unused code
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Code-quality (CA) rules switched off
# CA1716/CA1720 - identifiers that clash with VB keywords or contain type names (Object, Event, Integer)
# CA1816 - GC.SuppressFinalize in Dispose; only matters for types with finalizers
# CA1848/CA1873 - LoggerMessage delegates / lazy log-argument evaluation
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
